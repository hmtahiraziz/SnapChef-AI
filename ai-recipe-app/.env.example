# Local development API. Loopback (127.0.0.1 / localhost) is rewritten at runtime to
# your Metro/LAN host on a physical device. With `expo start --localhost` + USB, also run:
#   npm run adb:reverse
# Do NOT use a LAN IP in EAS preview/production — set a public HTTPS URL in Expo dashboard:
#   Project → Environment variables → preview / production → EXPO_PUBLIC_API_BASE_URL
#
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Clerk Publishable Key (required)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Public HTTPS Privacy Policy URL for Play Console + in-app “View online version”.
# Host docs/privacy-policy.md (GitHub Pages, Notion public page, etc.), then set:
# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://your-domain.example/privacy
