{
  "expo": {
    "name": "SnapChef AI",
    "slug": "ai-recipe-app",
    "version": "1.0.0",
    "owner": "technology726",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "airecipeapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap photos of ingredients to find recipes.",
        "NSPhotoLibraryUsageDescription": "Choose ingredient photos from your library."
      }
    },
    "android": {
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2A1F4A",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.technology726.airecipeapp"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Snap photos of ingredients to find recipes.",
          "photosPermission": "Choose ingredient photos from your library.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#8966FA",
            "cropToolbarIconColor": "#FFFFFF",
            "cropToolbarActionTextColor": "#FFFFFF",
            "cropBackButtonIconColor": "#FFFFFF",
            "cropBackgroundColor": "#0A0116"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#8966FA",
              "cropToolbarIconColor": "#FFFFFF",
              "cropToolbarActionTextColor": "#FFFFFF",
              "cropBackButtonIconColor": "#FFFFFF",
              "cropBackgroundColor": "#0A0116"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1F4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf654699-ddff-4d9e-b016-cfa7c1007b70"
      }
    }
  }
}
